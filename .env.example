# ============================================================
# EV Charging Optimizer — Environment Variables
# Phase 1 + Phase 2
#
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="EV Charging Optimizer"
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Leave blank to use SQLite (local dev default: ./ev_charging.db)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/ev_charging
DATABASE_URL=

# --- Redis (optional, Phase 2 caching) ---
# REDIS_URL=redis://localhost:6379/0

# --- Optimization ---
MAX_SOLVER_TIME_SECONDS=30
DEFAULT_CHARGING_EFFICIENCY=0.90

# --- External APIs (Phase 4) ---
# OPENWEATHER_API_KEY=your_key_here
# ELECTRICITY_PRICE_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
